<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maplibre="clr-namespace:MapLibreNative.Maui.Handlers;assembly=MapLibreNative.Maui.Handlers"
             x:Class="CartoPac_Mobile.MapPage"
             x:Name="MapPageRoot"
             Title="Map">

    <Grid>
        <maplibre:MapLibreMap x:Name="Map"
                              StyleUrl="https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"
                              MyLocationEnabled="True"
                              ShowGpsControl="False"
                              ShowNavigationControls="False" />

        <Button x:Name="GnssToggleButton"
                Text="GNSS Off"
                Clicked="OnGnssToggleClicked"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="12"
                Padding="12,8" />

    </Grid>

</ContentPage>
